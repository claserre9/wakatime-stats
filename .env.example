# Example environment configuration for local development
# Copy this file to .env and fill in your real values. Do NOT commit .env.

# Required
WAKATIME_API_KEY=your_wakatime_api_key
WAKATIME_USER_ID=your_wakatime_user_id
GH_TOKEN=your_github_token

# Optional (defaults shown)
# GitHub repository in the form <owner>/<repo>. When running in GitHub Actions, GITHUB_REPOSITORY is provided automatically.
GH_REPOSITORY=owner/repo

# Wakatime stats time range: one of last_7_days, last_30_days, last_6_months, last_year, all_time
WAKATIME_TIME_RANGE=all_time

# Table style: one of default, box, box-double
TABLE_STYLE=default

# Maximum number of languages to display (>=1)
MAX_LANGUAGES=5
