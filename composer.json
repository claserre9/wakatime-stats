{
    "name": "talma/wakatime-stats",
    "description": "Publish your wakatime stats into a github readme file",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Claserre9\\WakatimeStats\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Clifford Laserre",
            "email": "claserre9@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.8",
        "vlucas/phpdotenv": "^5.5",
        "ext-json": "*",
        "symfony/console": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "scripts": {
        "test": "phpunit",
        "analyze": "phpstan analyse -l 8 src",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix"
    }
}
